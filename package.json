{
  "name": "professionisti-platform",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @professionisti/database prisma generate",
    "db:migrate": "pnpm --filter @professionisti/database prisma migrate dev"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
