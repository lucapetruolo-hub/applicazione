{
  "name": "professionisti-platform",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @professionisti/database prisma generate",
    "db:migrate": "pnpm --filter @professionisti/database prisma migrate dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.27",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.1",
    "turbo": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
