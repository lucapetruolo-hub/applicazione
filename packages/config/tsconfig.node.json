{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    // TypeScript 6 non include più da solo tutti i pacchetti @types.
    "types": ["node"]
  }
}
