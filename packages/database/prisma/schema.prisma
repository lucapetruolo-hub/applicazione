// Schema Prisma — fonte di verità per il data model.
// Regola (CLAUDE.md §5.3): ogni nuova entità di dominio va riflessa qui
// prima di essere propagata ai client (apps/web, apps/mobile, apps/api).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// Estensione PostGIS non ancora richiesta qui: la ricerca è oggi filtrata per
// città come stringa (vedi CLAUDE.md §9), non per raggio geografico. Il
// requisito "extensions = [postgis]" bloccherebbe il deploy su un Postgres
// gestito standard (es. Railway) che non la include di default — da
// reintrodurre insieme al geocoding reale degli indirizzi professionista.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Utenti
// ---------------------------------------------------------------------------

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

model User {
  id           String    @id @default(uuid())
  role         UserRole  @default(CLIENT)
  // Login via email+password o Google (CLAUDE.md §8): con l'email+password
  // passwordHash è popolato; con Google resta nullo (nessuna password da
  // gestire per quell'account).
  email        String?   @unique
  passwordHash String?
  phone        String?   @unique
  googleId     String?   @unique
  // Nullable: al primo accesso (Google senza scope profilo) il nome
  // potrebbe non essere noto, va completato in un secondo momento.
  name         String?
  surname      String?
  birthDate    DateTime?
  // Immagine profilo, facoltativa — richiesta esplicita dell'utente: prima
  // solo ProfessionalProfile.imageUrl esisteva, i client non potevano
  // impostarne una. Stesso percorso Cloudinary (POST /auth/me/image),
  // nessun nuovo servizio di storage.
  imageUrl     String?
  // Indirizzo di default dell'account (richiesta esplicita dell'utente:
  // "possono essere inserite nella finestra impostazioni dell'account, in
  // modo che quando si richiede un preventivo escano automaticamente
  // compilate già nei campi") — facoltativo, editabile in /account.
  // GuidedRequestForm li usa solo come prefill iniziale del form, restano
  // sempre modificabili per singola richiesta (un cliente può avere lavori
  // in indirizzi diversi da una richiesta all'altra, stesso principio già
  // documentato per GuidedRequest.address prima di questo campo).
  street       String?
  houseNumber  String?
  addressExtra String?
  postalCode   String?
  city         String?
  province     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // Soft-delete (richiesta esplicita dell'utente): DELETE /auth/me non
  // cancella più fisicamente la riga. Le richieste guidate/lead/preventivi/
  // prenotazioni/recensioni create da questo utente hanno FK dirette su
  // User (onDelete: Cascade) — una vera delete le avrebbe cancellate con
  // lui, ma il professionista deve poter continuare a vederle ("account
  // eliminato" invece che scomparse nel nulla). `deletedAt` valorizzato +
  // PII anonimizzata (email/telefono/googleId/nome/cognome/immagine/
  // password) al posto della delete: la riga resta solo come ancora per le
  // FK, il login torna impossibile (email non più corrispondente, password
  // azzerata, googleId azzerato) senza dover cancellare nulla a cascata.
  deletedAt    DateTime?

  professionalProfile ProfessionalProfile?
  guidedRequests      GuidedRequest[]
  bookingsAsClient    Booking[]
  notifications       Notification[]
  savedProfessionals  SavedProfessional[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Categorie (specchio di packages/shared/src/categories.ts, gestibile da admin)
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String
  subTags   String[]
  createdAt DateTime @default(now())

  professionalProfiles ProfessionalProfile[]
  guidedRequests       GuidedRequest[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Profilo professionista
// ---------------------------------------------------------------------------

model ProfessionalProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  categoryId               String
  subTags                  String[]
  businessName             String
  city                     String
  latitude                 Float
  longitude                Float
  bio                      String?
  // Indirizzo del negozio/laboratorio (facoltativo: molti professionisti a
  // domicilio non ne hanno uno da mostrare pubblicamente), mostrato nella
  // card risultati e nel profilo pubblico come su miodottore.it.
  address                  String?
  imageUrl                 String?
  // Foto reali di lavori svolti (fino a 10), mostrate in una galleria sul
  // profilo pubblico — richiesta esplicita dell'utente: "in modo che gli
  // utenti aprendo l'account del professionista possano avere un'idea dei
  // lavori svolti". Stesso pattern/limite di GuidedRequest.photoUrls,
  // stesso upload Cloudinary già in uso per l'immagine profilo.
  portfolioUrls            String[] @default([])
  verified                 Boolean  @default(false)
  // Profilo di esempio creato dal seed script (packages/database/prisma/seed.ts,
  // PLACEHOLDER_PROFESSIONALS), mai un professionista reale — usato per
  // escludere questi profili dalle sezioni pubbliche che dichiarano
  // esplicitamente di mostrare dati reali (redesign "Scheda Intervento"
  // §4.6: mai spacciare vetrine finte per vere, CLAUDE.md §10).
  isDemo                   Boolean  @default(false)
  // Consulenza a distanza (video/telefono) oltre all'intervento a domicilio
  // (CLAUDE.md §1: "eventualmente consulenza da remoto" nei piani SaaS).
  remoteAvailable          Boolean  @default(false)
  // Raggio (km, max 25) entro cui il professionista riceve richieste dal
  // fan-out delle richieste guidate — richiesta esplicita dell'utente: due
  // raggi indipendenti, uno per le richieste standard e uno per quelle
  // urgenti (GuidedRequest.isUrgent), così un professionista può scegliere
  // di coprire una zona più ampia solo per gli interventi urgenti (o
  // viceversa) invece di un unico raggio fisso per tutti. Editabili in
  // /dashboard/profilo (EngagementRadiusMap), usati da
  // GuidedRequestsService per il filtro geografico del fan-out.
  engagementRadiusKm       Float    @default(25)
  urgentEngagementRadiusKm Float    @default(25)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Soft-delete (richiesta esplicita dell'utente, simmetrica a User.deletedAt
  // già in uso per il cliente — CLAUDE.md §16): prima l'eliminazione
  // dell'account professionista cancellava per davvero questa riga, che in
  // cascata (onDelete: Cascade su Booking.professionalProfileId e simili)
  // portava via anche tutte le prenotazioni/recensioni del cliente con lui
  // — un cliente non vedeva più nulla dei propri "Lavori accettati" passati.
  // Ora si marca solo `deletedAt`: il profilo sparisce da ricerca/profilo
  // pubblico/fan-out (ovunque filtrato esplicitamente), ma Booking/Lead/
  // Quote/Review restano intatti — lo stesso principio "traccia completa"
  // già applicato al soft-delete del cliente.
  deletedAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  subscription           Subscription?
  visibilityBoosts       VisibilityBoost[]
  leads                  Lead[]
  quotes                 Quote[]
  bookings               Booking[]
  payments               Payment[]
  savedBy                SavedProfessional[]
  services               ProfessionalService[]
  availabilitySlots      AvailabilitySlot[]
  availabilityExceptions AvailabilityException[]
  guidedRequests         GuidedRequest[]
  metrics                ProfessionalMetrics?

  @@index([categoryId, city])
  @@map("professional_profiles")
}

// Metriche di affidabilità (CLAUDE.md §15) — tabella collegata 1:1,
// separata dai dati anagrafici del profilo: aggiornata ad ogni evento
// operativo (richiesta ricevuta, prima risposta, lavoro accettato/
// completato, recensione, appuntamento onorato/mancato), a differenza dei
// campi di ProfessionalProfile che il professionista modifica lui stesso.
// Creata alla prima occorrenza di uno di questi eventi (nessuna riga finché
// non succede nulla), non alla creazione del profilo — un professionista
// che si è appena iscritto senza ancora aver ricevuto nulla non ha
// metriche da mostrare, `null`/riga assente è lo stato corretto, non "zero
// finto". Nessun trigger/middleware Prisma: ogni aggiornamento è scritto
// esplicitamente nel service che esegue l'azione corrispondente
// (ProfessionalMetricsService, richiamato da lì), stessa convenzione già
// in uso in tutto il progetto (es. NotificationsService.notify()).
model ProfessionalMetrics {
  id                     String   @id @default(uuid())
  professionalProfileId  String   @unique
  // Media mobile dei minuti trascorsi tra la ricezione di un Lead e il
  // primo preventivo inviato per quello stesso Lead — misura la reattività
  // DI QUESTO professionista, non l'età della richiesta originale (che può
  // essere più vecchia se il Lead è nato da un'espansione, CLAUDE.md §14).
  avgResponseTimeMinutes Float?
  // Denominatore della media mobile sopra (il numero di prime-risposte già
  // misurate) — non coincide con totalRequestsReceived: un professionista
  // può ricevere Lead senza mai rispondere, quelli non contano nella media.
  totalResponsesMeasured Int      @default(0)
  // Lead ricevuti in totale (fan-out iniziale + espansione + coinvolgimento
  // a posteriori, CLAUDE.md §14) — non "richieste create", quelle di per sé
  // possono generare più Lead per più professionisti diversi.
  totalRequestsReceived  Int      @default(0)
  // Preventivi che sono diventati una Booking reale (Quote → Booking,
  // "accettato" nel vocabolario di questo dominio — vedi
  // BookingsService.createFromQuote/QuotesService.confirmProposedDate).
  acceptedRequests       Int      @default(0)
  // Bookings segnate COMPLETED (BookingsService.completeWithFinalAmount).
  completedJobs          Int      @default(0)
  // Bookings create da un preventivo accettato — stesso momento di
  // acceptedRequests, campo distinto perché lo STEP 3 (formula del
  // punteggio) li usa con significati diversi (tasso di completamento =
  // completedJobs/acceptedJobs).
  acceptedJobs           Int      @default(0)
  // Media reale delle recensioni ricevute (ricalcolata da zero ad ogni
  // nuova recensione, non una media mobile: il numero di recensioni per
  // professionista resta basso abbastanza da non giustificare
  // l'approssimazione, e una media esatta è più corretta).
  avgRating              Float?
  reviewCount            Int      @default(0)
  // COMPLETED = onorato, NO_SHOW = mancato (BookingStatus) — CANCELED
  // volutamente escluso da entrambi i contatori: un annullamento (da
  // cliente o professionista) non è né un appuntamento onorato né uno
  // mancato dal professionista, è un evento diverso.
  honoredAppointments    Int      @default(0)
  totalAppointments      Int      @default(0)
  lastActivityAt         DateTime @default(now())
  // Calcolato (STEP 3), non impostato manualmente — vedi
  // calculateReliabilityScore in professional-metrics.service.ts. `null`
  // finché completedJobs < 3 (troppo pochi dati per essere significativo,
  // richiesta esplicita dell'utente). Deliberatamente NON usato oggi per
  // ordinare o filtrare nulla (selectLeadCandidates in
  // GuidedRequestsService riusa invece il rating live dalle recensioni,
  // §14) — solo calcolato e salvato, in vista di un utilizzo futuro.
  reliabilityScore       Float?
  updatedAt              DateTime @default(now()) @updatedAt

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@map("professional_metrics")
}

// Prestazioni offerte dal professionista con prezzo facoltativo (mostrate
// nella card risultati e nel profilo pubblico, come le voci "Colloquio
// psicologico — 60€" nel riferimento miodottore.it fornito dall'utente).
// Salvate come lista semplice (nessun editing granulare per singola voce):
// ad ogni salvataggio del profilo l'intera lista viene sostituita, coerente
// con la scala attesa (poche voci a professionista).
model ProfessionalService {
  id                    String   @id @default(uuid())
  professionalProfileId String
  name                  String
  // Range invece di prezzo fisso: molti lavori (es. "sostituzione caldaia")
  // hanno un costo che varia da caso a caso, un prezzo unico era fuorviante.
  // Se solo priceMinEurCents è impostato viene mostrato come prezzo singolo
  // (vedi formatServicePriceRange in packages/shared).
  priceMinEurCents      Int?
  priceMaxEurCents      Int?
  createdAt             DateTime @default(now())

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@map("professional_services")
}

// Disponibilità settimanale ricorrente (non date specifiche): il
// professionista indica in quali giorni della settimana e fasce orarie è
// disponibile, mostrata poi come agenda nel profilo pubblico (CLAUDE.md §8:
// "Notifiche quasi istantanee..." e agenda digitale come feature core SaaS).
// dayOfWeek segue la convenzione di JS `Date.getUTCDay()` (0=domenica...
// 6=sabato) apposta, per confrontare senza conversioni la disponibilità
// ricorrente con le prenotazioni reali (Booking.scheduledAt) quando si
// calcola l'agenda pubblica.
model AvailabilitySlot {
  id                    String    @id @default(uuid())
  professionalProfileId String
  dayOfWeek             Int
  startTime             String
  endTime               String
  // Se valorizzata, la fascia vale SOLO per questa data esatta (non
  // ricorrente) — nuovo comportamento di default richiesto esplicitamente
  // dall'utente: aggiungere una fascia da una colonna del calendario la
  // lega a quella data specifica, non più a "ogni <dayOfWeek> per sempre".
  // La spunta "ripeti per tutti i <giorno> del mese" nell'editor crea una
  // riga per ciascuna data del mese corrente con lo stesso giorno della
  // settimana, invece di introdurre un concetto di ricorrenza aperta.
  // `date === null` resta il comportamento storico (ricorrenza settimanale
  // indefinita per dayOfWeek) — non più creabile dalla UI, ma le fasce già
  // esistenti create prima di questa funzionalità continuano a funzionare
  // così: nessuna migrazione distruttiva dei dati esistenti.
  date                  DateTime?
  // Capienza della fascia. 1 (default) = fascia "esatta": un solo impegno,
  // il cliente la prenota istantaneamente e occupa l'intero orario. > 1 =
  // fascia "generica" (es. "9–13, fino a 5
  // richieste"): un click non prenota nulla, apre una richiesta di
  // preventivo precompilata con quella data/fascia (GuidedRequest.
  // preferredDate/preferredTimeSlot) — più clienti possono richiedere nella
  // stessa finestra, il professionista sceglie poi con chi fissare
  // l'appuntamento reale.
  maxBookings           Int       @default(1)
  createdAt             DateTime  @default(now())

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@map("availability_slots")
}

// Giorno di chiusura straordinaria (ferie, festività, imprevisto): una data
// specifica in cui il professionista non è disponibile nonostante la
// ricorrenza settimanale di AvailabilitySlot lo preveda. Modello separato
// invece di un campo su AvailabilitySlot: la ricorrenza settimanale e le
// eccezioni puntuali hanno cicli di vita indipendenti (la prima cambia di
// rado, le seconde si aggiungono/rimuovono una alla volta) — confonderle in
// un'unica entità avrebbe reso "sostituisci tutta la lista ad ogni
// salvataggio" (pattern già in uso per gli slot) scomodo per un'aggiunta
// estemporanea di un solo giorno. `date` normalizzata a mezzanotte UTC
// (stessa convenzione "data pura, nessun fuso" già in uso per
// ProfessionalAgendaDay/scheduledAt in questo modulo).
model AvailabilityException {
  id                    String   @id @default(uuid())
  professionalProfileId String
  date                  DateTime
  createdAt             DateTime @default(now())

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@unique([professionalProfileId, date])
  @@map("availability_exceptions")
}

// ---------------------------------------------------------------------------
// Professionisti salvati dal cliente (preferiti) — sezione account cliente
// ---------------------------------------------------------------------------

model SavedProfessional {
  id                    String   @id @default(uuid())
  userId                String
  professionalProfileId String
  createdAt             DateTime @default(now())

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, professionalProfileId])
  @@map("saved_professionals")
}

// ---------------------------------------------------------------------------
// Monetizzazione — abbonamenti SaaS (CLAUDE.md §6)
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                    String             @id @default(uuid())
  professionalProfileId String             @unique
  plan                  SubscriptionPlan   @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId  String?            @unique
  currentPeriodEnd      DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Monetizzazione — pacchetti di visibilità (CLAUDE.md §6)
// ---------------------------------------------------------------------------

enum VisibilityBoostType {
  BOOST_LOCALE
  BADGE_REPUTAZIONE
  STORIA_SUCCESSO
}

enum VisibilityBoostStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

model VisibilityBoost {
  id                    String                @id @default(uuid())
  professionalProfileId String
  type                  VisibilityBoostType
  status                VisibilityBoostStatus @default(ACTIVE)
  startsAt              DateTime              @default(now())
  endsAt                DateTime?
  stripePaymentId       String?

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@index([professionalProfileId, status])
  @@map("visibility_boosts")
}

// ---------------------------------------------------------------------------
// Richiesta guidata cliente → lead ai professionisti (CLAUDE.md §7-8)
// ---------------------------------------------------------------------------

enum GuidedRequestStatus {
  OPEN
  MATCHED
  CLOSED
}

// Perché la richiesta è passata a CLOSED — nullable, valorizzato solo in
// quel momento: distingue nella UI/nell'endpoint di stato aggregato
// (GuidedRequestsService.getStatus) "nessuno ha risposto in tempo" da
// "il cliente ha annullato" da "si è conclusa con una prenotazione",
// invece di un'unica etichetta generica "CLOSED" che oggi non dice il
// motivo.
enum GuidedRequestClosedReason {
  EXPIRED
  CANCELED_BY_CLIENT
  COMPLETED
}

model GuidedRequest {
  id                    String                     @id @default(uuid())
  clientId              String
  categoryId            String
  description           String
  photoUrls             String[]
  city                  String
  // Via (indirizzo del luogo dell'intervento), facoltativo a livello DB —
  // obbligatorio lato Zod alla creazione (guidedRequestSchema). Sulla
  // richiesta (non sul profilo cliente): un cliente può avere lavori in
  // indirizzi diversi da una richiesta all'altra. Mai mostrato in
  // ricerca/profilo pubblico — solo al professionista che ha in mano un
  // preventivo/prenotazione collegati a questa richiesta.
  address               String?
  // Destinatario + resto dell'indirizzo strutturato (numero civico,
  // dettagli, CAP, provincia — city esiste già sopra), raccolti insieme al
  // resto della richiesta fin dall'invio (richiesta esplicita dell'utente:
  // "voglio che li inserisca subito appena [invia] un preventivo... ma
  // verranno visualizzati al professionista... solo quando si è conclusa
  // la trattativa e confermato l'appuntamento") — prima raccolti solo
  // all'accettazione del preventivo (vedi Booking.recipientName e affini,
  // ancora presenti lì: `BookingsService.createFromQuote` li copia da qui
  // sul Booking al momento della creazione, non più da un input separato
  // del cliente). Nascosti al professionista in ProfessionalLead
  // (ProfessionalsService.getMyLeads) finché non esiste un Booking:
  // restano visibili solo `address`/`city` sopra, come già prima di
  // questo campo.
  recipientName         String?
  recipientSurname      String?
  recipientPhone        String?
  houseNumber           String?
  addressExtra          String?
  postalCode            String?
  province              String?
  isUrgent              Boolean                    @default(false)
  status                GuidedRequestStatus        @default(OPEN)
  createdAt             DateTime                   @default(now())
  // Per l'ordinamento "per ultimo aggiornamento" nelle liste richieste
  // (richiesta esplicita dell'utente) — Prisma la aggiorna da sola ad ogni
  // update() (es. modifica descrizione/città/foto).
  updatedAt             DateTime                   @default(now()) @updatedAt
  // Valorizzati solo quando la richiesta parte da una fascia "generica"
  // dell'agenda pubblica di un professionista (AvailabilitySlot.maxBookings
  // > 1): data pura (mezzanotte UTC, stessa convenzione del resto
  // dell'agenda) + fascia oraria testuale "HH:MM-HH:MM". Servono a contare
  // quante richieste sono già state inviate per quella fascia specifica
  // (capienza massima) e a mostrarla al professionista nel lead.
  // professionalProfileId denormalizzato (oltre al Lead che nasce comunque
  // dal fan-out) perché qui serve un riferimento diretto e univoco per
  // contare la capienza senza passare da un join su Lead.
  preferredDate         DateTime?
  preferredTimeSlot     String?
  professionalProfileId String?
  // Scadenza della richiesta nel suo complesso (non del singolo Lead, vedi
  // Lead.expiresAt sotto) — oltre questa data, se ancora OPEN/MATCHED senza
  // esito, il job schedulato la chiude (closedReason EXPIRED). Nullable:
  // le richieste create prima di questa funzionalità non ne hanno una e
  // non scadono mai retroattivamente, stessa convenzione già usata per
  // AvailabilitySlot.date (nullable = comportamento storico invariato).
  expiresAt             DateTime?
  // Perché è CLOSED — vedi GuidedRequestClosedReason sopra. Nullable finché
  // la richiesta è aperta, e per le righe chiuse prima dell'introduzione di
  // questo campo (nessun backfill retroattivo).
  closedReason          GuidedRequestClosedReason?
  // Coda ordinata (dal più al meno prioritario) dei ProfessionalProfile.id
  // candidati NON selezionati al fan-out iniziale (oltre MAX_LEADS_PER_REQUEST,
  // vedi GuidedRequestsService) — pescata in ordine da lì ad ogni scadenza/
  // rifiuto di un Lead per creare il successivo. Array nativo Postgres,
  // stesso pattern già in uso per liste ordinate in questo schema
  // (photoUrls, portfolioUrls, subTags) invece di una tabella dedicata o
  // di un campo Json: qui non serve altro che leggerla/consumarla in ordine.
  reserveCandidateIds   String[]                   @default([])

  client              User                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category            Category             @relation(fields: [categoryId], references: [id])
  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: SetNull)

  leads  Lead[]
  quotes Quote[]

  @@index([categoryId, city, status])
  @@map("guided_requests")
}

// Modello a pagamento per lead qualificato, fase iniziale prima dell'upsell
// ad abbonamento flat (CLAUDE.md §7.3).
enum LeadStatus {
  PENDING
  PAID
  CONVERTED
  // Il professionista ha rifiutato la richiesta prima di inviare un
  // preventivo (richiesta esplicita dell'utente: un pop-up con nota
  // facoltativa per il cliente) — distinto dal ritiro di un preventivo già
  // inviato (Quote.WITHDRAWN), che riguarda uno stadio successivo.
  DECLINED
  // Il professionista non ha risposto entro expiresAt — distinto da
  // DECLINED (rifiuto attivo, con nota per il cliente): qui semplicemente
  // il tempo è scaduto, il cliente non deve leggere "ha rifiutato" per un
  // professionista che magari non ha nemmeno visto la richiesta. Innesca
  // l'espansione verso il prossimo candidato in coda (vedi
  // GuidedRequest.reserveCandidateIds).
  EXPIRED
}

model Lead {
  id                    String     @id @default(uuid())
  guidedRequestId       String
  professionalProfileId String
  priceEurCents         Int
  status                LeadStatus @default(PENDING)
  // Nota facoltativa lasciata dal professionista quando rifiuta la
  // richiesta (es. "non copro quella zona"), mostrata al cliente.
  declineNote           String?
  // Scadenza del singolo Lead (non della GuidedRequest nel suo complesso,
  // vedi GuidedRequest.expiresAt): passato questo momento senza una Quote
  // collegata, il job schedulato lo marca EXPIRED e pesca il prossimo
  // candidato dalla coda di riserva. Nullable per lo stesso motivo di
  // GuidedRequest.expiresAt (righe esistenti create prima di questa
  // funzionalità, mai retroattivamente scadute).
  expiresAt             DateTime?
  // True se questo Lead è nato da un'espansione (scadenza o rifiuto di un
  // Lead precedente, o coinvolgimento di un professionista iscritto dopo),
  // non dal fan-out iniziale — utile solo per capire a colpo d'occhio
  // l'origine di un Lead in eventuali audit/debug, non usato oggi in UI.
  wasExpanded           Boolean    @default(false)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @default(now()) @updatedAt

  guidedRequest       GuidedRequest       @relation(fields: [guidedRequestId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@unique([guidedRequestId, professionalProfileId])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Preventivo strutturato in-app (CLAUDE.md §8)
// ---------------------------------------------------------------------------

enum QuoteStatus {
  SENT
  ACCEPTED
  REJECTED
  // Il cliente ha proposto una data diversa da estimatedStartDate (scelta
  // tra le fasce libere dell'agenda del professionista): resta così finché
  // il professionista non conferma (→ ACCEPTED, crea la Booking) o rifiuta
  // (torna a SENT). Mai una prenotazione automatica sulla sola richiesta
  // del cliente: evita che due clienti "vincano" la stessa fascia solo
  // proponendola, la capienza va sempre validata di nuovo alla conferma.
  MODIFICATION_REQUESTED
  // Il professionista ritira un preventivo già inviato (richiesta esplicita
  // dell'utente) — distinto da REJECTED (che significa "il cliente lo ha
  // rifiutato"): stesso stato finale ("non più valido"), ma il messaggio
  // mostrato all'altra parte deve essere diverso a seconda di chi ha agito.
  WITHDRAWN
}

model Quote {
  id                      String      @id @default(uuid())
  guidedRequestId         String
  professionalProfileId   String
  estimatedStartDate      DateTime
  // Fine della fascia scelta dall'agenda del professionista (richiesta
  // esplicita dell'utente: "non visualizzare solo il primo orario ma
  // tutta la fascia d'orario") — nullable: null quando la data è stata
  // indicata a mano (nessuna agenda impostata, vecchio input libero) o per
  // i preventivi creati prima di questa funzionalità, casi in cui non
  // esiste una fascia con fine nota.
  estimatedEndDate        DateTime?
  // Data alternativa proposta dal cliente (vedi QuoteStatus.MODIFICATION_REQUESTED),
  // valorizzata solo in quello stato — null altrimenti.
  clientProposedDate      DateTime?
  // Fine della fascia proposta dal cliente, stesso motivo di estimatedEndDate.
  clientProposedEndDate   DateTime?
  // Dettagli facoltativi scritti dal cliente insieme alla data proposta
  // (es. "posso solo dopo le 17" o "meglio se venite con il furgone"),
  // mostrati al professionista quando deve confermare/rifiutare.
  clientProposedNote      String?
  // Nota lasciata dal professionista quando modifica direttamente
  // l'orario proposto dal cliente durante la trattativa (invece di
  // confermarlo o rifiutarlo semplicemente) — richiesta esplicita
  // dell'utente: "Modifica (in giallo)... con una casella di testo dove si
  // può scrivere qualcosa e inviare". Distinta da `notes` (voci/dettagli
  // del preventivo, mai sovrascritti da questo flusso). Azzerata quando il
  // cliente propone una nuova data (negoziazione ripartita da capo) o
  // quando il professionista modifica di nuovo (sostituita).
  professionalCounterNote String?
  notes                   String?
  status                  QuoteStatus @default(SENT)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @default(now()) @updatedAt

  guidedRequest       GuidedRequest       @relation(fields: [guidedRequestId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  items               QuoteItem[]

  booking Booking?

  @@map("quotes")
}

// Voce di un preventivo (es. "Manodopera", "Materiali", "Trasporto"), ognuna
// col proprio range di prezzo — sostituisce i due campi fissi
// laborEurCents/materialsEurCents: un preventivo può avere quante voci
// servono, non solo manodopera+materiali (CLAUDE.md, richiesta esplicita
// dell'utente). Stesso pattern range min/max di ProfessionalService.
model QuoteItem {
  id               String @id @default(uuid())
  quoteId          String
  name             String
  priceMinEurCents Int?
  priceMaxEurCents Int?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_items")
}

// ---------------------------------------------------------------------------
// Prenotazione, recensione (solo da prenotazione confermata — CLAUDE.md §8)
// ---------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

// Chi ha annullato la prenotazione — richiesta esplicita dell'utente:
// "Lavori accettati" deve far capire non solo che è stata annullata ma
// anche da chi (cliente o professionista), non solo dal messaggio
// "Annullata" da solo.
enum BookingCanceledBy {
  CLIENT
  PROFESSIONAL
}

model Booking {
  id                    String        @id @default(uuid())
  quoteId               String?       @unique
  clientId              String
  professionalProfileId String
  scheduledAt           DateTime
  // Fine della fascia (richiesta esplicita dell'utente: mostrare tutta la
  // fascia oraria, non solo l'inizio), copiata da Quote.estimatedEndDate/
  // clientProposedEndDate al momento della creazione — null per le
  // prenotazioni dirette da agenda pubblica (bookAgendaSlot, che già
  // conosce la fascia esatta ma non passa da questo campo) o per date
  // indicate a mano senza agenda impostata.
  scheduledEndAt        DateTime?
  status                BookingStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Indirizzo di lavoro strutturato, raccolto in una schermata dedicata
  // all'accettazione del preventivo (richiesta esplicita dell'utente: nome,
  // cognome, telefono, indirizzo, civico, CAP, città, provincia in campi
  // separati, tutti obbligatori tranne addressExtra). Nullable a livello DB
  // perché le prenotazioni dirette da agenda pubblica (bookAgendaSlot) non
  // passano da questa schermata; obbligatori lato Zod/API solo nel percorso
  // di accettazione preventivo (acceptQuoteSchema). Sostituisce, per le
  // prenotazioni create da questo momento in poi, il precedente indirizzo
  // libero di GuidedRequest.address come fonte principale mostrata al
  // professionista.
  recipientName    String?
  recipientSurname String?
  recipientPhone   String?
  street           String?
  houseNumber      String?
  addressExtra     String?
  postalCode       String?
  city             String?
  province         String?

  // Importo finale esatto (richiesta esplicita dell'utente: "segnala lavoro
  // terminato" apre una finestra dove inserire l'importo preciso seguendo le
  // voci del preventivo, più eventuali voci aggiuntive) — valorizzato solo
  // al completamento, somma di BookingFinalItem, denormalizzato qui per
  // mostrarlo senza dover sempre fare la join. Le voci del preventivo
  // (QuoteItem, range min/max) non vengono mai modificate: rappresentano
  // l'offerta originale, l'importo finale è un dato separato.
  finalAmountEurCents Int?
  finalItems          BookingFinalItem[]

  // Nota per il cliente quando il professionista annulla un intervento già
  // confermato (richiesta esplicita dell'utente) — facoltativa, distinta
  // dall'annullamento lato cliente (cancelForClient), che non ne raccoglie una.
  cancellationNote String?

  // Chi ha annullato — richiesta esplicita dell'utente: "Lavori accettati"
  // deve far capire da chi è stata annullata, non solo che lo è stata.
  // Null finché non CANCELED, o per righe annullate prima di questo campo.
  // Valorizzato in tutti e tre i percorsi che possono portare a CANCELED:
  // cancelForClient (CLIENT), cancelByProfessional e updateStatus quando lo
  // stato passa a CANCELED dal calendario (PROFESSIONAL in entrambi i casi).
  canceledBy BookingCanceledBy?

  // Nota privata del professionista per ricordare dettagli sulla
  // prenotazione (es. "portare il pezzo di ricambio", richiesta esplicita
  // dell'utente) — mai mostrata al cliente, a differenza di
  // cancellationNote sopra. Modificabile liberamente finché la prenotazione
  // esiste, indipendentemente dallo stato.
  professionalNote String?

  // Link per una consulenza video (es. Google Meet), facoltativo — richiesta
  // esplicita dell'utente per la "consulenza online" già prevista in
  // CLAUDE.md §1 (ProfessionalProfile.remoteAvailable). Impostabile dal
  // professionista su qualunque prenotazione (nessun vincolo su
  // remoteAvailable: anche un lavoro tipicamente in presenza può iniziare
  // con una videochiamata di sopralluogo), mostrato al cliente come link
  // cliccabile quando presente. Nessuna integrazione reale con Google
  // Meet/Calendar: il professionista incolla qui il link della propria
  // videochiamata (Meet, Zoom, ecc. — nessun vincolo di piattaforma),
  // stesso principio pragmatico già seguito per WhatsApp (nessuna API,
  // solo un link wa.me costruito dal numero già raccolto).
  meetingLink String?

  // Il cliente segnala che il professionista non si è presentato
  // all'appuntamento (dopo la data/ora prevista) e chiede un rimborso —
  // richiesta esplicita dell'utente. Puramente informativo/di notifica:
  // nessun pagamento reale da rimborsare in piattaforma (non ancora
  // attivo, CLAUDE.md §9) — il rimborso vero va concordato direttamente
  // con il professionista nel frattempo, stesso principio già seguito per
  // "Vai al pagamento". Non tocca `status`: quello resta CONFIRMED finché
  // il professionista stesso non lo segna completato/annullato, il
  // professionista può ancora contestare la segnalazione.
  refundRequested   Boolean   @default(false)
  refundRequestedAt DateTime?

  quote               Quote?              @relation(fields: [quoteId], references: [id])
  client              User                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  review Review?

  @@index([professionalProfileId, scheduledAt])
  @@map("bookings")
}

// Voce dell'importo finale di un lavoro completato (richiesta esplicita
// dell'utente): segue le voci del preventivo originale ma con un prezzo
// esatto invece di un range, più eventuali voci aggiunte in questa fase
// (es. materiale extra non preventivato). Stesso pattern di QuoteItem.
model BookingFinalItem {
  id            String @id @default(uuid())
  bookingId     String
  name          String
  priceEurCents Int

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_final_items")
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  rating    Int
  comment   String?
  // Foto del lavoro svolto, opzionali (fino a 3, stesso limite/pattern di
  // GuidedRequest.photoUrls): caricate su Cloudinary dal cliente al momento
  // della recensione, mostrate poi nella sezione recensioni del professionista.
  photoUrls String[] @default([])
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Pagamenti (lead, abbonamento, boost — CLAUDE.md §1, §6)
// ---------------------------------------------------------------------------

enum PaymentType {
  LEAD
  SUBSCRIPTION
  VISIBILITY_BOOST
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                    String        @id @default(uuid())
  professionalProfileId String
  type                  PaymentType
  amountEurCents        Int
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ---------------------------------------------------------------------------
// Notifiche — promemoria automatici anti no-show (CLAUDE.md §1)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel
  type      String
  payload   Json
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Waitlist "in costruzione" — homepage, sezione professionisti in evidenza
// quando non ci sono ancora abbastanza profili reali (redesign "Scheda
// Intervento" §4.6): cattura l'email di chi vuole essere avvisato quando la
// sua zona è coperta, invece di un form decorativo che non fa nulla.
// ---------------------------------------------------------------------------

model WaitlistSignup {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("waitlist_signups")
}
