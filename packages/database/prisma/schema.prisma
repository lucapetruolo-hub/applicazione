// Schema Prisma — fonte di verità per il data model.
// Regola (CLAUDE.md §5.3): ogni nuova entità di dominio va riflessa qui
// prima di essere propagata ai client (apps/web, apps/mobile, apps/api).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// Estensione PostGIS non ancora richiesta qui: la ricerca è oggi filtrata per
// città come stringa (vedi CLAUDE.md §9), non per raggio geografico. Il
// requisito "extensions = [postgis]" bloccherebbe il deploy su un Postgres
// gestito standard (es. Railway) che non la include di default — da
// reintrodurre insieme al geocoding reale degli indirizzi professionista.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Utenti
// ---------------------------------------------------------------------------

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

model User {
  id       String   @id @default(uuid())
  role     UserRole @default(CLIENT)
  // Login via email+password o Google (CLAUDE.md §8): con l'email+password
  // passwordHash è popolato; con Google resta nullo (nessuna password da
  // gestire per quell'account).
  email        String? @unique
  passwordHash String?
  phone        String? @unique
  googleId     String? @unique
  // Nullable: al primo accesso (Google senza scope profilo) il nome
  // potrebbe non essere noto, va completato in un secondo momento.
  name      String?
  surname   String?
  birthDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professionalProfile ProfessionalProfile?
  guidedRequests      GuidedRequest[]
  bookingsAsClient    Booking[]
  notifications       Notification[]
  savedProfessionals  SavedProfessional[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Categorie (specchio di packages/shared/src/categories.ts, gestibile da admin)
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String
  subTags   String[]
  createdAt DateTime @default(now())

  professionalProfiles ProfessionalProfile[]
  guidedRequests       GuidedRequest[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Profilo professionista
// ---------------------------------------------------------------------------

model ProfessionalProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  categoryId   String
  subTags      String[]
  businessName String
  city         String
  latitude     Float
  longitude    Float
  bio          String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  subscription     Subscription?
  visibilityBoosts VisibilityBoost[]
  leads            Lead[]
  quotes           Quote[]
  bookings         Booking[]
  payments         Payment[]
  savedBy          SavedProfessional[]

  @@index([categoryId, city])
  @@map("professional_profiles")
}

// ---------------------------------------------------------------------------
// Professionisti salvati dal cliente (preferiti) — sezione account cliente
// ---------------------------------------------------------------------------

model SavedProfessional {
  id                    String   @id @default(uuid())
  userId                String
  professionalProfileId String
  createdAt             DateTime @default(now())

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, professionalProfileId])
  @@map("saved_professionals")
}

// ---------------------------------------------------------------------------
// Monetizzazione — abbonamenti SaaS (CLAUDE.md §6)
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                    String             @id @default(uuid())
  professionalProfileId String             @unique
  plan                  SubscriptionPlan   @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId  String?            @unique
  currentPeriodEnd      DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Monetizzazione — pacchetti di visibilità (CLAUDE.md §6)
// ---------------------------------------------------------------------------

enum VisibilityBoostType {
  BOOST_LOCALE
  BADGE_REPUTAZIONE
  STORIA_SUCCESSO
}

enum VisibilityBoostStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

model VisibilityBoost {
  id                    String                 @id @default(uuid())
  professionalProfileId String
  type                  VisibilityBoostType
  status                VisibilityBoostStatus  @default(ACTIVE)
  startsAt              DateTime               @default(now())
  endsAt                DateTime?
  stripePaymentId       String?

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@index([professionalProfileId, status])
  @@map("visibility_boosts")
}

// ---------------------------------------------------------------------------
// Richiesta guidata cliente → lead ai professionisti (CLAUDE.md §7-8)
// ---------------------------------------------------------------------------

enum GuidedRequestStatus {
  OPEN
  MATCHED
  CLOSED
}

model GuidedRequest {
  id          String              @id @default(uuid())
  clientId    String
  categoryId  String
  description String
  photoUrls   String[]
  city        String
  isUrgent    Boolean             @default(false)
  status      GuidedRequestStatus @default(OPEN)
  createdAt   DateTime            @default(now())

  client   User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  leads  Lead[]
  quotes Quote[]

  @@index([categoryId, city, status])
  @@map("guided_requests")
}

// Modello a pagamento per lead qualificato, fase iniziale prima dell'upsell
// ad abbonamento flat (CLAUDE.md §7.3).
enum LeadStatus {
  PENDING
  PAID
  CONVERTED
}

model Lead {
  id                    String     @id @default(uuid())
  guidedRequestId       String
  professionalProfileId String
  priceEurCents         Int
  status                LeadStatus @default(PENDING)
  createdAt             DateTime   @default(now())

  guidedRequest       GuidedRequest       @relation(fields: [guidedRequestId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@unique([guidedRequestId, professionalProfileId])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Preventivo strutturato in-app (CLAUDE.md §8)
// ---------------------------------------------------------------------------

enum QuoteStatus {
  SENT
  ACCEPTED
  REJECTED
}

model Quote {
  id                    String      @id @default(uuid())
  guidedRequestId       String
  professionalProfileId String
  laborEurCents         Int
  materialsEurCents     Int
  estimatedStartDate    DateTime
  notes                 String?
  status                QuoteStatus @default(SENT)
  createdAt             DateTime    @default(now())

  guidedRequest       GuidedRequest       @relation(fields: [guidedRequestId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  booking Booking?

  @@map("quotes")
}

// ---------------------------------------------------------------------------
// Prenotazione, recensione (solo da prenotazione confermata — CLAUDE.md §8)
// ---------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

model Booking {
  id                    String        @id @default(uuid())
  quoteId               String?       @unique
  clientId              String
  professionalProfileId String
  scheduledAt           DateTime
  status                BookingStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  quote               Quote?              @relation(fields: [quoteId], references: [id])
  client              User                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  review Review?

  @@index([professionalProfileId, scheduledAt])
  @@map("bookings")
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Pagamenti (lead, abbonamento, boost — CLAUDE.md §1, §6)
// ---------------------------------------------------------------------------

enum PaymentType {
  LEAD
  SUBSCRIPTION
  VISIBILITY_BOOST
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                     String        @id @default(uuid())
  professionalProfileId  String
  type                   PaymentType
  amountEurCents         Int
  status                 PaymentStatus @default(PENDING)
  stripePaymentIntentId  String?       @unique
  createdAt              DateTime      @default(now())

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ---------------------------------------------------------------------------
// Notifiche — promemoria automatici anti no-show (CLAUDE.md §1)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  channel   NotificationChannel
  type      String
  payload   Json
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@map("notifications")
}
