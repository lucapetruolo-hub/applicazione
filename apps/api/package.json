{
  "name": "@professionisti/api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "pnpm --filter @professionisti/database build && pnpm --filter @professionisti/shared build && nest build",
    "dev": "nest start --watch",
    "start": "node ../../packages/database/scripts/migrate-deploy.mjs && node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "email:preview": "tsx scripts/email-preview.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@professionisti/database": "workspace:*",
    "@professionisti/shared": "workspace:*",
    "@sentry/nestjs": "^10.75.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "google-auth-library": "^9.14.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.1",
    "rxjs": "^7.8.1",
    "stripe": "^22.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@professionisti/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  }
}
