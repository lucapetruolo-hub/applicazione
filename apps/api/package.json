{
  "name": "@professionisti/api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "pnpm --filter @professionisti/database build && pnpm --filter @professionisti/shared build && nest build",
    "dev": "nest start --watch",
    "start": "pnpm --filter @professionisti/database exec prisma db push --skip-generate --accept-data-loss && node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@professionisti/database": "workspace:*",
    "@professionisti/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "google-auth-library": "^9.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@professionisti/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
