PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/professionisti?schema=public"

# Auth
JWT_SECRET="change-me-in-production"

# Login con Google (opzionale finché non configurato — vedi CLAUDE.md §8)
GOOGLE_CLIENT_ID=""

# Stripe: abbonamenti, pagamento lead, boost visibilità (opzionale finché non
# configurato — senza queste variabili gli endpoint /billing/* rispondono con
# un errore chiaro invece di andare in crash, vedi CLAUDE.md §9)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""
STRIPE_PRICE_BASE=""
STRIPE_PRICE_PLUS=""
STRIPE_PRICE_PRO=""
# Giorno del lancio (AAAA-MM-GG): il mese gratuito parte da qui (docs/CHANGELOG.md §170)
LAUNCH_DATE=""
FRONTEND_URL="http://localhost:3000"

# Anti-bot Cloudflare Turnstile su POST /auth/register (opzionale,
# docs/CHANGELOG.md §204): senza questa variabile il controllo è spento.
# Chiave di prova che passa sempre: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=""
# Chiave dei dati fiscali (IBAN). Senza, in locale si usa JWT_SECRET.
FISCAL_DATA_KEY=""
# Tetto giornaliero alle chiamate a Google dalle rotte aperte a tutti (§293). Vuoto = tetti di serie.
GOOGLE_PUBLIC_DAILY_LIMIT=""
# Dal problema scritto ai mestieri (docs/CHANGELOG.md §392): Claude Haiku
# solo quando il dizionario ha un dubbio. Vuoto = solo dizionario.
ANTHROPIC_API_KEY=""
# Solo fino al lancio (§394): senza ANTHROPIC_API_KEY, lo stesso modello
# attraverso OpenRouter. OPENROUTER_MODEL vuoto = google/gemma-4-31b-it:free (gratuito, docs/changelog/2026-10-28-ia-gratuita-fino-al-lancio.md);
# anthropic/claude-haiku-5.5 con credito su OpenRouter.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
# Tetto giornaliero delle domande all'intelligenza artificiale (vuoto = 3000).
PROBLEM_MATCH_AI_DAILY_LIMIT=""

# Promemoria su WhatsApp con Meta (docs/whatsapp-modelli.md). Vuoti: nessun messaggio parte.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_DAILY_LIMIT=500
