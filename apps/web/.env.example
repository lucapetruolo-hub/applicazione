NEXT_PUBLIC_API_URL="http://localhost:3001"

# Login con Google (opzionale): senza questa variabile il pulsante "Continua
# con Google" non viene mostrato, invece di mostrare un pulsante che non
# funziona (vedi CLAUDE.md §8). Va creato su console.cloud.google.com.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Anti-bot Cloudflare Turnstile sulla registrazione con email (opzionale,
# docs/CHANGELOG.md §199): senza questa variabile il widget non compare.
# Va in coppia con TURNSTILE_SECRET_KEY sull'API. Chiave di prova che passa
# sempre: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
