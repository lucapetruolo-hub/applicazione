{
  "extends": "@professionisti/config/tsconfig.nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // React 19 solo nel sito: i pacchetti condivisi (packages/ui, Tamagui)
      // troverebbero i tipi di React 18 dell'app mobile nella radice del
      // monorepo. Così tutto il sito si controlla con un'unica versione (se
      // un giorno i tipi 19 finissero nella radice, si ricade su quelli).
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    },
    // Stesso ordine di risoluzione del webpack in next.config.mjs
    // (resolve.extensions con ".web.*" prima): senza questo, tsc
    // risolverebbe "./icons" di packages/ui su icons.tsx (lucide-react-native)
    // invece di icons.web.tsx (lucide-react) durante il typecheck — nessun
    // bug a runtime (il bundle usa comunque il file giusto), ma un
    // disallineamento inutile tra ciò che tsc controlla e ciò che gira.
    "moduleSuffixes": [".web", ""]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
